# =====================================================================
#  Fichier de configuration SECRET (copie de .env.example -> .env)
#  Ne jamais partager ce fichier. Il n'est jamais lu par personne d'autre
#  que l'application sur votre ordinateur.
#  Une ligne vide = option désactivée.
# =====================================================================

# --- Accès à l'application (facultatif mais conseillé si ouverte au Wi-Fi)
# Si renseigné, le navigateur demandera ce mot de passe (identifiant : immo)
APP_PASSWORD=

# --- Lecture des e-mails : option A (recommandée) = API Microsoft (Outlook/Hotmail)
# "ID d'application (client)" obtenu en enregistrant une application gratuite
# sur https://entra.microsoft.com (voir README, étape 3).
MS_CLIENT_ID=

# --- Lecture des e-mails : option B = IMAP (ex. Gmail avec "mot de passe d'application")
# Utile si vous transférez les alertes de Hotmail vers une boîte Gmail.
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# --- Temps de trajet en voiture + géolocalisation : OpenRouteService (gratuit)
# Clé obtenue sur https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# --- Temps de trajet en transports en commun : API mobiliteit.lu (gratuite, sur demande)
# Clé ("accessId") à demander par e-mail à l'administration des transports publics (voir README).
MOBILITEIT_API_KEY=

# --- Mot de passe de la version en ligne (consultation sur le telephone)
SITE_PASSWORD=
